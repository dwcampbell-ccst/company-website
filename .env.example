# Supabase (backend/serverless)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used by some tools/scripts
SUPABASE_ANON_KEY=

# SMTP (contact notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Website Contact <no-reply@example.com>"
CONTACT_RECEIVER_EMAIL=you@example.com

# HubSpot (CRM contact sync)
# Create a HubSpot Private App and paste the access token here.
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional: map your custom HubSpot Contact properties to store extra fields
# (Create these properties in HubSpot first. Common defaults: service_of_interest, message_multi_line)
HUBSPOT_CONTACT_TOPICS_PROPERTY=
HUBSPOT_CONTACT_MESSAGE_PROPERTY=
HUBSPOT_CONTACT_SUBJECT_PROPERTY=
HUBSPOT_CONTACT_DOWNLOAD_PROPERTY=
