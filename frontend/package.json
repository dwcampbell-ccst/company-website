{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:generate": "node scripts/generate-decap-config.mjs && node scripts/generate-content.mjs",
    "predev": "npm run content:generate",
    "dev": "vite",
    "prebuild": "npm run content:generate",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "pretest": "npm run content:generate",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "3.0.0",
    "react-router-dom": "6.30.4",
    "sanitize-html": "2.17.6"
  }
}
